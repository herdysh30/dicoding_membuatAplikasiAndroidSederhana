<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SubmissionAplikasiAndroidSederhana" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/gray_light</item>
        <item name="colorPrimaryVariant">@color/gray</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/orange_light</item>
        <item name="colorSecondaryVariant">@color/orange_light</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>

    <style name="Theme.SubmissionAplikasiAndroidSederhana" parent="Base.Theme.SubmissionAplikasiAndroidSederhana">
        <item name="android:statusBarColor">@color/gray</item>
    </style>

    <style name="Theme.SubmissionAplikasiAndroidSederhana.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/gray</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


</resources>