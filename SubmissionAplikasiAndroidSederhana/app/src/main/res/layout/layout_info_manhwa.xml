<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/text_author_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Author:"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/text_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Author Name"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/text_author_title"
        app:layout_constraintTop_toTopOf="@id/text_author_title"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/text_genre_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Genre:"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/text_author_title"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/text_genre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Genre Name"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/text_genre_title"
        app:layout_constraintTop_toTopOf="@id/text_genre_title"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/text_published_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Published:"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/text_genre_title"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/text_published"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="2024"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/text_published_title"
        app:layout_constraintTop_toTopOf="@id/text_published_title"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
